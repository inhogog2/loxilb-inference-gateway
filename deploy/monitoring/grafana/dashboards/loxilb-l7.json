        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "No data"
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "type": "row",
      "collapsed": true,
      "title": "Half-close holds (only on services whose half_close_mode, or the default mode, is hold)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 36
      },
      "panels": [
        {
          "id": 13,
          "type": "stat",
          "title": "Holds taken",
          "description": "Clients held after a half-close instead of being cut at their FIN, over the dashboard's time range. Set the range to the window being judged.",
          "gridPos": {
            "h": 4,
            "w": 4,
            "x": 0,
            "y": 37
          },
          "datasource": {
            "type": "prometheus",
            "uid": "loxilb-prom"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "round(sum(increase(loxilb_proxy_halfclose_hold_total{instance=~\"$instance\"}[$__range])))"
            }
          ],
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "colorMode": "none",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "auto"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "No data",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          }
        },
        {
          "id": 14,
          "type": "stat",
          "title": "Client FINs with an answer owed",
          "description": "Client FINs that arrived while an answer was still owed, on plaintext connections the kernel never carried, on every fullproxy service whether it holds or not, over the dashboard's time range: the clients a hold is for. Near zero means holding changes little here.",
          "gridPos": {
            "h": 4,
            "w": 4,
            "x": 4,
            "y": 37
          },
          "datasource": {
            "type": "prometheus",
            "uid": "loxilb-prom"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "round(sum(increase(loxilb_proxy_halfclose_fin_total{instance=~\"$instance\",outcome=\"owed\"}[$__range])))"
            }
          ],
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "colorMode": "none",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "auto"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "No data",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          }
        },
        {
          "id": 15,
          "type": "stat",
          "title": "Holds expired before the answer began",
          "description": "Held clients closed by the idle bound before any answer byte reached them, over the dashboard's time range: a first byte slower than the bound, or a cancel that was waited on as a half-close. Should be 0.",
          "gridPos": {
            "h": 4,
            "w": 4,
            "x": 8,
            "y": 37
          },
          "datasource": {
            "type": "prometheus",
            "uid": "loxilb-prom"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "round(sum(increase(loxilb_proxy_halfclose_hold_expired_total{instance=~\"$instance\",answer_started=\"false\"}[$__range])))"
            }
          ],
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "colorMode": "value",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "auto"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "No data",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "red",
                    "value": 1
                  }
                ]
              }
            },
            "overrides": []
          }
        },
        {
          "id": 16,
          "type": "stat",
          "title": "Held clients' EOF re-entries",
          "description": "Times a held client's EOF was handled again, over the dashboard's time range. Should stay 0: anything else is a defect to report.",
          "gridPos": {
            "h": 4,
            "w": 4,
            "x": 12,
            "y": 37
          },
          "datasource": {
            "type": "prometheus",
            "uid": "loxilb-prom"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "round(sum(increase(loxilb_proxy_halfclose_hold_spurious_wakeups_total{instance=~\"$instance\",kind=\"eof_reentry\"}[$__range])))"
            }
          ],
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "colorMode": "value",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "auto"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "No data",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "red",
                    "value": 1
                  }
                ]
              }
            },
            "overrides": []
          }
        },
        {
          "id": 17,
          "type": "stat",
          "title": "Held now",
          "description": "Clients held open now after a half-close, waiting for their answers to go out.",
          "gridPos": {
            "h": 4,
            "w": 4,
            "x": 16,
            "y": 37
          },
          "datasource": {
            "type": "prometheus",
            "uid": "loxilb-prom"
          },
          "targets": [
            {
              "refId": "A",
              "expr": "sum(loxilb_proxy_halfclose_held{instance=~\"$instance\"})"
            }
          ],
          "options": {
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ],
              "fields": "",
              "values": false
            },
            "colorMode": "none",
            "graphMode": "none",
            "justifyMode": "auto",
            "orientation": "auto"
          },
          "fieldConfig": {
            "defaults": {
              "unit": "short",
              "noValue": "No data",
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  }
                ]
              }
            },
            "overrides": []
          }
        },
        {
          "id": 18,
          "type": "stat",
          "title": "Oldest hold",
          "description": "How long the oldest client held now has been held; 0 when none is. A hold ends on idleness, not age, so a long answer that keeps coming holds a client well past the bound.",
          "gridPos": {
